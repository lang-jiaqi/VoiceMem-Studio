# Copy to the repository root .env. Exported values take precedence over that file.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=       # Only for --llm openai/local or --mode realtime

# Optional OpenAI-compatible model services. The desktop App manages these
# fields for its owned local backend; headless Linux deployments set them here.
# VOICEMEM_MEMORY_PROVIDER=deepseek
# VOICEMEM_MEMORY_MODEL=deepseek-v4-flash
# VOICEMEM_MEMORY_BASE_URL=https://api.deepseek.com
# VOICEMEM_STUDIO_PROVIDER=deepseek
# VOICEMEM_STUDIO_MODEL=deepseek-v4-flash
# VOICEMEM_STUDIO_BASE_URL=https://api.deepseek.com

# Optional component bindings. Omit this to retain the recommended pipeline.
# Credentials stay separate from the JSON; see core/utils/component_config/README.md.
# STUDIO_COMPONENTS='{"asr":{"provider":"deepgram","model":"nova-3","language":"zh"},"speech":{"provider":"openai","model":"gpt-4o-mini-tts","voice":"alloy"}}'
# STUDIO_ASR_API_KEY=
# STUDIO_SPEECH_API_KEY=

# Optional trained decision router; keep checkpoint files outside Git.
# STUDIO_COMPONENTS='{"router":{"provider":"adapter","factory":"studio.core.utils.reply_modes.laya:create","model":"/path/to/checkpoint","options":{"backend":"onnx","device":"cpu","allow_prototype":true}}}'
# Independent filler wording for that adapter. An OpenAI-compatible local server
# can use a loopback base URL and an empty explicit API key.
# STUDIO_FILLER_PROVIDER=deepseek
# STUDIO_FILLER_MODEL=deepseek-v4-flash
# STUDIO_FILLER_BASE_URL=https://api.deepseek.com
# STUDIO_FILLER_API_KEY=
# STUDIO_FILLER_TIMEOUT_S=3.0

# Startup flags override these options. Defaults work with sibling Breeze repos.
# STUDIO_BACKEND=cuda
# STUDIO_DEVICE=cuda:0
# STUDIO_ASR_DEVICE=auto
# STUDIO_ASR_FINAL_GRACE_S=0.03           # Preference window before accepting a ready stream flush
# STUDIO_GATE_TIMEOUT_S=0.15             # Confirmation wait; 0 disables the bound
# STUDIO_TTS_DEVICE=cuda:0
# STUDIO_MODELS_DIR=/path/to/VoiceMem-Studio/studio/models
# STUDIO_PROMPT_DIR=/path/to/complete/studio/prompt
# BREEZE_CODE_DIR=/path/to/breeze-tts
# BREEZE_MODEL_DIR=/path/to/breeze-tts-2
# STUDIO_DESKTOP_PET=0                    # Native: disable Electron; Docker always disables it

# Docker-only host binding; container-internal model paths and GPU 0 are fixed by Compose.
# STUDIO_PORT=8787
# STUDIO_BIND_HOST=127.0.0.1
# TZ=Asia/Shanghai

# Copy to .env. Exported environment values take precedence over this file.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=       # Only for --llm openai/local or --mode realtime
# DASHSCOPE_API_KEY=    # Only for --llm qwen

# Optional OpenAI-compatible model services. The desktop App manages these
# fields for its owned local backend; headless Linux deployments set them here.
# VOICEMEM_MEMORY_PROVIDER=deepseek
# VOICEMEM_MEMORY_MODEL=deepseek-v4-flash
# VOICEMEM_MEMORY_BASE_URL=https://api.deepseek.com
# VOICEMEM_STUDIO_PROVIDER=deepseek
# VOICEMEM_STUDIO_MODEL=deepseek-v4-flash
# VOICEMEM_STUDIO_BASE_URL=https://api.deepseek.com

# Startup flags override these options. Defaults work with sibling Breeze repos.
# STUDIO_BACKEND=cuda
# STUDIO_DEVICE=cuda:0
# STUDIO_TTS_DEVICE=cuda:0
# STUDIO_MODELS_DIR=/path/to/VoiceMem-Studio/studio/models
# BREEZE_CODE_DIR=/path/to/breeze-tts
# BREEZE_MODEL_DIR=/path/to/breeze-tts-2
# STUDIO_DESKTOP_PET=0                    # Native: disable Electron; Docker always disables it

# Docker-only host binding; container-internal model paths and GPU 0 are fixed by Compose.
# STUDIO_PORT=8787
# STUDIO_BIND_HOST=127.0.0.1
# TZ=Asia/Shanghai

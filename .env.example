# Copy to .env; fill values locally. Never commit real keys.
DEEPSEEK_API_KEY=
STUDIO_PUBLIC_DEMO=1

# Singapore Qwen system-voice TTS. Leave both empty to use local Breeze.
STUDIO_QWEN_TTS_API_KEY=
STUDIO_QWEN_TTS_WORKSPACE_ID=
STUDIO_QWEN_TTS_VOICE=longanlingxi
STUDIO_DEMO_MAX_TTS_SESSIONS=4

# Optional reuse of existing deployment data and weights.
# STUDIO_MODELS_DIR=/path/to/existing/studio/models
# STUDIO_DEMO_DATA_DIR=/path/to/existing/demo-data
